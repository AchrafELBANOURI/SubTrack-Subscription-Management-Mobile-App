{
  "expo": {
    "name": "SubTrack",
    "slug": "SubTrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-subtrack.png",
    "scheme": "subtrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo-subtrack.png",
      "bundleIdentifier": "com.achraf.SubTrack"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.achraf.SubTrack"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-screen-subtrack.png",
          "resizeMode": "contain",
          "backgroundColor": "#fff9e3",
          "imageWidth" : 350
        }
      ],
      "@clerk/expo",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6d886f66-00b4-4189-b562-78319459ba3b"
      }
    }
  }
}
